# Copy to .env and adjust as needed.

# PostgreSQL
POSTGRES_USER=guidegenie
POSTGRES_PASSWORD=guidegenie
POSTGRES_DB=guidegenie
POSTGRES_HOST=localhost
# Host port mapped to the container. 5433 avoids clashing with a native
# PostgreSQL install that already occupies 5432.
POSTGRES_PORT=5433

# Backend database URL (used by FastAPI). Uses the psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://guidegenie:guidegenie@localhost:5433/guidegenie
