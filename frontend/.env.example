# Copy to .env.local and adjust as needed.

# Base URL of the FastAPI backend. Must be reachable from the browser, so use
# the host address (not a Docker service name). Variables prefixed with
# NEXT_PUBLIC_ are exposed to client-side code.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Google Maps Static API key, used to render per-day route maps in the
# itinerary view. Enable "Maps Static API" on the same Google Cloud project
# as the backend's GOOGLE_ROUTES_API_KEY. Get one at
# https://console.cloud.google.com/apis/library/static-maps-backend.googleapis.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
